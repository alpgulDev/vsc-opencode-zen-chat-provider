{
  "name": "opencode-zen-chat-provider",
  "publisher": "wienans",
  "displayName": "OpenCode Zen Provider",
  "description": "Provides OpenCode Zen models to VS Code's Language Model API.",
  "version": "0.1.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/wienans/vsc-opencode-zen-chat-provider.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ai",
    "claude",
    "gpt",
    "agent",
    "coding",
    "assistant",
    "chat provider",
    "opencode"
  ],
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:opencodeZen.signIn",
    "onCommand:opencodeZen.signOut",
    "onCommand:opencodeZen.refreshModels",
    "onCommand:opencodeZen.addModels",
    "onCommand:opencodeZen.revertAgentsWindowSupport",
    "onLanguageModelChatProvider:opencode",
    "onLanguageModelChatProvider:opencode-agent",
    "onCommand:opencodeZen.restartTransport",
    "onCommand:opencodeZen.selfTest",
    "onCommand:opencodeZen.selfTestOnce"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "opencode",
        "displayName": "OpenCode Zen",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "OpenCode Zen API Key",
              "description": "Optional when signed in with OpenCode Zen: Sign In. Stored by VS Code as a secret for Add Models groups.",
              "secret": true
            },
            "lane": {
              "type": "string",
              "enum": ["auto", "zen", "go"],
              "default": "auto",
              "description": "Which OpenCode inference lane to expose. 'auto' includes both."
            }
          }
        }
      },
      {
        "vendor": "opencode-agent",
        "displayName": "OpenCode Zen (Agents)",
        "when": "config.opencodeZen.showAgentModelsInManagePanel"
      }
    ],
    "commands": [
      {
        "command": "opencodeZen.signIn",
        "title": "OpenCode Zen: Sign In"
      },
      {
        "command": "opencodeZen.signOut",
        "title": "OpenCode Zen: Sign Out"
      },
      {
        "command": "opencodeZen.refreshModels",
        "title": "OpenCode Zen: Refresh Model List"
      },
      {
        "command": "opencodeZen.addModels",
        "title": "OpenCode Zen: Add Models"
      },
      {
        "command": "opencodeZen.revertAgentsWindowSupport",
        "title": "OpenCode Zen: Revert Agents Window Support"
      },
      {
        "command": "opencodeZen.restartTransport",
        "title": "OpenCode Zen: Restart Bun-Compatible Transport"
      },
      {
        "command": "opencodeZen.selfTest",
        "title": "OpenCode Zen: Self Test"
      },
      {
        "command": "opencodeZen.selfTestOnce",
        "title": "OpenCode Zen: Self Test (One Request)"
      }
    ],
    "configuration": {
      "title": "OpenCode Zen",
      "properties": {
        "opencodeZen.agentsWindow": {
          "type": "boolean",
          "default": true,
          "description": "Register OpenCode Zen models in the Copilot Agents window model picker."
        },
        "opencodeZen.autoEnableAgentsWindow": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enable the VS Code settings required for OpenCode Zen models in the Agents window."
        },
        "opencodeZen.showAgentModelsInManagePanel": {
          "type": "boolean",
          "default": false,
          "description": "Show the OpenCode Zen (Agents) vendor in the Language Models management editor."
        },
        "opencodeZen.modelCacheTtlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "How long to cache model metadata before refetching. 0 disables caching."
        },
        "opencodeZen.transport.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the extension-owned Bun-compatible HTTP transport and route inference through it."
        },
        "opencodeZen.transport.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a locally built zen-transport executable. Overrides the bundled helper."
        },
        "opencodeZen.promptCaching.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable prompt caching hints for supported providers (Anthropic, OpenAI, OpenAI-compatible)."
        },
        "opencodeZen.promptCaching.retention": {
          "type": "string",
          "enum": ["in_memory", "24h"],
          "default": "in_memory",
          "description": "Retention policy for OpenAI prompt caching. '24h' requires a compatible OpenAI model."
        },
        "opencodeZen.promptCaching.cacheKeyScope": {
          "type": "string",
          "enum": ["workspace", "global", "none"],
          "default": "workspace",
          "description": "Scope for the prompt cache key used by OpenAI/OpenAI-compatible providers."
        },
        "opencodeZen.promptCaching.anthropicTtl": {
          "type": "string",
          "enum": ["5m", "1h", "none"],
          "default": "5m",
          "description": "Anthropic cache_control TTL for cached message blocks. 'none' omits TTL."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:gateway",
    "compile": "node scripts/copy-assets.mjs && tsc -p ./",
    "build:gateway": "node scripts/build-gateway.mjs",
    "watch": "node scripts/copy-assets.mjs && tsc -watch -p ./",
    "lint": "eslint",
    "test:parity": "npm run compile && npm run build:gateway && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/google": "^2.0.22",
    "@ai-sdk/openai": "^3.0.12",
    "@ai-sdk/openai-compatible": "^2.0.13",
    "ai": "^6.0.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/dts": "^0.4.1",
    "eslint": "^9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
